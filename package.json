{
  "name": "choicelab-app",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "1.0.1",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "preDev": "bun run player:check && concurrently 'vite' 'bun run player:watch'",
    "preBuild": "bun run acknowledgments && bun run gen-vocab && NODE_OPTIONS=--max-old-space-size=4096 tsc && bun run player:build && NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "player:check": "bash scripts/check-player-build.sh",
    "player:build": "vite build --config src/player/vite.config.ts",
    "player:watch": "vite build --watch --config src/player/vite.config.ts",
    "gen-vocab": "bun scripts/embeddings/trim-glove.ts",
    "test-classifier": "bun scripts/embeddings/test-classifier.ts",
    "dev": "tauri dev",
    "keygen": "bun run tauri signer generate -w ~/.tauri/myapp.key",
    "build": "export TAURI_SIGNING_PRIVATE_KEY=~/.tauri/myapp.key && tauri build",
    "preview": "vite preview",
    "clean": "cd src-tauri && cargo clean && cd ../",
    "install-all": "cd src-tauri && cargo build && cd ../ && bun install",
    "upgrade-all": "bun update && cd src-tauri && cargo update",
    "acknowledgments": "node scripts/acknowledgments.cjs",
    "changelog": "node scripts/changelog.cjs",
    "version-major": "git status && git diff-index --quiet HEAD -- && bumpp major --no-push --execute 'node scripts/version.cjs && bun run changelog'",
    "version-minor": "git status && git diff-index --quiet HEAD -- && bumpp minor --no-push --execute 'node scripts/version.cjs && bun run changelog'",
    "version-patch": "git status && git diff-index --quiet HEAD -- && bumpp patch --no-push --execute 'node scripts/version.cjs && bun run changelog'",
    "lint": "eslint src",
    "tauri": "tauri"
  },
  "dependencies": {
    "can-autoplay": "^3.0.2",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2",
    "@tauri-apps/plugin-os": "~2",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-shell": "~2",
    "@tauri-apps/plugin-updater": "~2",
    "@types/uuid": "^10.0.0",
    "@ungap/structured-clone": "^1.2.0",
    "compare-versions": "^6.1.1",
    "fs": "^0.0.1-security",
    "lodash": "^4.17.21",
    "path": "^0.12.7",
    "preact": "^10.18.2",
    "preact-markdown": "^2.1.0",
    "prism-code-editor": "^4.1.0",
    "tauri-plugin-accent-color": "git+https://github.com/freethinkel/tauri-plugin-accent-color",
    "uint8-to-base64": "^0.2.0",
    "uuid": "^11.1.0",
    "wavesurfer.js": "^7.8.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/lodash": "^4.17.16",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/ungap__structured-clone": "^1.2.0",
    "bumpp": "^11.0.1",
    "eslint": "^9.39.2",
    "fflate": "^0.8.2",
    "sass": "^1.69.5",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.3.5",
    "concurrently": "^9.1.2",
    "vite-plugin-svgr": "^5.0.0"
  }
}
